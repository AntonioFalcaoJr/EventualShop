<Project>
    <PropertyGroup Label="Common properties">
        <Product>Eventual Shop</Product>
        <Copyright>Copyright (c) 2021-2024 Antonio Falcão Jr.</Copyright>
        <Authors>Antônio Falcão Jr.</Authors>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <EnablePreviewFeatures>true</EnablePreviewFeatures>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!--<TreatWarningsAsErrors>true</TreatWarningsAsErrors>-->
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup Label="Packages">
        <!--Ardalis.SmartEnum-->
        <PackageVersion Include="Ardalis.SmartEnum" Version="8.2.0"/>
        <PackageVersion Include="Ardalis.SmartEnum.AutoFixture" Version="8.1.0"/>
        <PackageVersion Include="Ardalis.SmartEnum.SystemTextJson" Version="8.1.0"/>
        <!--Asp.Versioning-->
        <PackageVersion Include="Asp.Versioning.Http" Version="8.1.0"/>
        <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0"/>
        <!--AutoFixture-->
        <PackageVersion Include="AutoFixture" Version="5.0.0-preview0012"/>
        <PackageVersion Include="AutoFixture.Xunit2" Version="5.0.0-preview0012"/>
        <PackageVersion Include="BlazorStrap" Version="5.2.103.250102"/>
        <!--BlazorStrap-->
        <PackageVersion Include="BlazorStrap.V5" Version="5.2.103.122024"/>
        <PackageVersion Include="Bogus" Version="35.6.1"/>
        <!--CorrelationId-->
        <PackageVersion Include="CorrelationId" Version="3.0.1"/>
        <!--Coverlet-->
        <PackageVersion Include="coverlet.collector" Version="6.0.4"/>
        <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="8.14.6"/>
        <!--FluentAssertions-->
        <PackageVersion Include="FluentAssertions" Version="8.0.1"/>
        <PackageVersion Include="FluentResults" Version="3.16.0"/>
        <!--FluentValidation-->
        <PackageVersion Include="FluentValidation" Version="12.0.0-preview1"/>
        <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.0"/>
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0-preview1"/>
        <!--Fluxor-->
        <PackageVersion Include="Fluxor" Version="6.5.2"/>
        <PackageVersion Include="Fluxor.Blazor.Web" Version="6.5.2"/>
        <PackageVersion Include="Fluxor.Blazor.Web.ReduxDevTools" Version="6.5.2"/>
        <!--Grpc-->
        <PackageVersion Include="Google.Protobuf" Version="3.29.3"/>
        <PackageVersion Include="Grpc.AspNetCore" Version="2.67.0"/>
        <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.56.0-pre1"/>
        <PackageVersion Include="Grpc.AspNetCore.Server.ClientFactory" Version="2.67.0"/>
        <PackageVersion Include="Grpc.Net.Client" Version="2.67.0"/>
        <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.67.0"/>
        <PackageVersion Include="Grpc.Tools" Version="2.69.0"/>
        <!--JsonNet-->
        <PackageVersion Include="JsonNet.ContractResolvers" Version="2.0.0"/>
        <PackageVersion Include="LanguageExt.Core" Version="5.0.0-beta-46"/>
        <!--MassTransit-->
        <PackageVersion Include="MassTransit" Version="8.3.6"/>
        <PackageVersion Include="MassTransit.Newtonsoft" Version="8.3.6"/>
        <PackageVersion Include="MassTransit.Quartz" Version="8.3.6"/>
        <PackageVersion Include="MassTransit.RabbitMQ" Version="8.3.6"/>
        <!--MediatR-->
        <PackageVersion Include="MediatR" Version="12.4.1"/>
        <PackageVersion Include="MediatR.Contracts" Version="2.0.1"/>
        <!--MicroElements.Swashbuckle-->
        <PackageVersion Include="MicroElements.Swashbuckle.FluentValidation" Version="6.1.0"/>
        <!--Microsoft.AspNetCore-->
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.1"/>
        <!--Microsoft.EntityFrameworkCore-->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.1"/>
        <!--Microsoft.Extensions-->
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0-preview.3.23174.8"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.Fast.Components.FluentUI" Version="3.8.0"/>
        <PackageVersion Include="Microsoft.NET.Sdk.WebAssembly.Pack" Version="9.0.1"/>
        <!--Microsoft.NET.Test-->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageVersion Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.0"/>
        <!--MongoDB-->
        <PackageVersion Include="MongoDB.Bson" Version="3.1.0"/>
        <PackageVersion Include="MongoDB.Driver" Version="3.1.0"/>
        <PackageVersion Include="NEST" Version="7.17.5"/>
        <!--Newtonsoft-->
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.3"/>
        <!--OpenTelemetry-->
        <PackageVersion Include="OpenTelemetry.Exporter.Jaeger" Version="1.6.0-rc.1"/>
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0"/>
        <!--Polly-->
        <PackageVersion Include="Polly" Version="8.5.1"/>
        <!--Quartz-->
        <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.13.1"/>
        <PackageVersion Include="Quartz.Serialization.Json" Version="3.13.1"/>
        <PackageVersion Include="Refit" Version="8.0.0"/>
        <PackageVersion Include="Refit.HttpClientFactory" Version="8.0.0"/>
        <!--Serilog-->
        <PackageVersion Include="Serilog" Version="4.2.1-dev-02337"/>
        <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0"/>
        <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0"/>
        <PackageVersion Include="Serilog.Settings.Configuration" Version="9.0.1-dev-02317"/>
        <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0"/>
        <PackageVersion Include="Serilog.Sinks.Elasticsearch" Version="10.0.0"/>
        <!--Swashbuckle-->
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="7.2.0"/>
        <PackageVersion Include="Swashbuckle.AspNetCore.Newtonsoft" Version="7.2.0"/>
        <!--System.IdentityModel-->
        <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.0.0"/>
        <PackageVersion Include="System.Text.Json" Version="8.0.4"/>
        <PackageVersion Include="Ulid" Version="1.3.3"/>
        <!--xUnit-->
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.1"/>
    </ItemGroup>
</Project>